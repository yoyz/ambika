@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix atom: <http://lv2plug.in/ns/ext/atom#> .
@prefix midi: <http://lv2plug.in/ns/ext/midi#> .
@prefix param: <http://lv2plug.in/ns/ext/parameters#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ambika: <https://ambika.opencode/softsynth#> .

<https://ambika.opencode/softsynth>
    a lv2:Plugin ;
    lv2:binary <ambika.so> ;
    rdfs:label "Ambika" ;
    rdfs:comment "6-voice hybrid polyphonic softsynth based on the Ambika voicecard engine" ;
    lv2:optionalFeature lv2:hardRapable ;
    lv2:port [
        a lv2:InputPort , atom:AtomPort ;
        atom:bufferType atom:Sequence ;
        atom:supports midi:MidiEvent ;
        lv2:index 0 ;
        lv2:symbol "midi_in" ;
        lv2:name "MIDI In"
    ] , [
        a lv2:OutputPort , lv2:AudioPort ;
        lv2:index 1 ;
        lv2:symbol "audio_out_l" ;
        lv2:name "Audio Out L"
    ] , [
        a lv2:OutputPort , lv2:AudioPort ;
        lv2:index 2 ;
        lv2:symbol "audio_out_r" ;
        lv2:name "Audio Out R"
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 3 ;
        lv2:symbol "osc1_shape" ;
        lv2:name "Osc1 Shape" ;
        lv2:default 0 ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 4 ;
        lv2:symbol "osc1_pwm" ;
        lv2:name "Osc1 PWM" ;
        lv2:default 0.25 ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 5 ;
        lv2:symbol "osc1_range" ;
        lv2:name "Osc1 Range" ;
        lv2:default 0.5 ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 6 ;
        lv2:symbol "osc1_detune" ;
        lv2:name "Osc1 Detune" ;
        lv2:default 0.5 ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 7 ;
        lv2:symbol "osc2_shape" ;
        lv2:name "Osc2 Shape" ;
        lv2:default 0.0909091 ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 8 ;
        lv2:symbol "osc2_param" ;
        lv2:name "Osc2 Param" ;
        lv2:default 0 ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
